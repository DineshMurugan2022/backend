# Backend Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/crm_db

# Security Secrets (MUST CHANGE THESE IN PRODUCTION)
# Generate random strings using: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: External Services
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASS=
